{
  "name": "little-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A small, offline desktop toolbox. Image to text is the first tool.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "node scripts/prepare-tools.mjs",
    "build": "node scripts/prepare-tools.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "tauri": "tauri",
    "check": "tsc -b && vitest run",
    "check:native": "node scripts/desktop.mjs --test-rust",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
